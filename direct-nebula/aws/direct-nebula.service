[Unit]
Description=Direct Nebula for Couchbase Capella Nodes
After=network.target
StartLimitIntervalSec=60

[Service]
Type=simple
User=nebula
Group=nebula
LimitNOFILE=65536

Restart=always
RestartSec=10

WorkingDirectory=/home/nebula
ExecStart=/home/nebula/direct-nebula

# make sure log directory exists and owned by syslog
PermissionsStartOnly=true
ExecStartPre=/usr/bin/mkdir -p /var/log/direct-nebula
ExecStartPre=/usr/bin/chmod 755 /var/log/direct-nebula
ExecStartPre=/usr/bin/curl -i -XPOST --max-time 5 http://localhost:12011/v1/service-start
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=directnebula

[Install]
WantedBy=graphical.target
