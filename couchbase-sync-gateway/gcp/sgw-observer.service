# systemd version 219 installed on nodes
[Unit]
Description=SGW Observer for Couchbase Capella syncgateway Nodes
After=network.target
After=sgw-agent.service


[Service]
Type=simple
User=ec2-user
Group=ec2-user
LimitNOFILE=1024

# automatically restart service on failure only, not on expected shutdown (i.e. non-0 exit codes)
Restart=always
# time to sleep in seconds before attempting to auto-restart the service
RestartSec=10

WorkingDirectory=/home/ec2-user
ExecStart=/home/ec2-user/sgw-observer

# make sure log directory exists and owned by syslog
PermissionsStartOnly=true
ExecStartPre=/usr/bin/mkdir -p /var/log/sgw-observer
ExecStartPre=/usr/bin/chmod 755 /var/log/sgw-observer
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=sgwobserver

[Install]
WantedBy=graphical.target
