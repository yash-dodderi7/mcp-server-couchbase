## Product Info
export PKR_VAR_product_pkg_name=couchbase-server-enterprise_7.6.2-3541-linux_amd64.deb
export PKR_VAR_product_version=7.6.2
export PKR_VAR_product_bld_num=3541
export PKR_VAR_product_arch=amd64

## ns_server profile: provisioned, coloumnar, serverless
export PKR_VAR_ns_server_profile=provisioned

## Agent service: dp-agent or dp-backup.
export PKR_VAR_dp_service=dp-agent

## agent sha
export PKR_VAR_agent_sha=c2c7574b

## Azure variables that are required to publish the image
export PKR_VAR_subscription_id=<azure subscription id>
export PKR_VAR_client_id=<azure client id>
export PKR_VAR_client_secret=<azure client secret>
export PKR_VAR_resource_group=image-factory
export PKR_VAR_image_gallery=capella
export PKR_VAR_image_definition=couchbase-cloud-server-7.1.3
## Azure only accept version in the form of major.minor.patch.
export PKR_VAR_image_name=couchbase-cloud-server-7.6.2-v3541.0.33
export PKR_VAR_image_version=3541.0.33

# Default region where the image is gnerated.
export PKR_VAR_region=eastus
# Regions the image should be replicated to.  replication_regions is a list
export PKR_VAR_replication_regions='["australiaeast", "brazilsouth", "centralindia", "centralus", "canadacentral", "eastasia", "eastus", "eastus2", "francecentral", "germanywestcentral", "swedencentral", "japaneast", "koreacentral", "northeurope", "norwayeast", "southeastasia", "southcentralus", "switzerlandnorth", "uaenorth", "uksouth", "westeurope", "westus2", "westus3"]'
