[Unit]
Description=Capella Model Agent Monitor for Language Model Hosting Nodes in Capella
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
LimitNOFILE=1024

Restart=on-failure
RestartSec=10

WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/model-serving-agent
PermissionsStartOnly=true

# log output to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=modelservingagent

[Install]
WantedBy=graphical.target
